# Database Configuration
DB_HOST=your_db_host
DB_PORT=your_db_port
DB_USER=your_db_user
DB_NAME=your_db_name
DB_PASSWORD=your_db_password
DB_SSLMODE=your_db_sslmode

# JWT Configuration
JWT_SECRET=your_jwt_secret

# Service Configuration
GATEWAY_PORT=your_gateway_port
USER_SERVICE_PORT=your_user_service_port
PRODUCT_SERVICE_PORT=your_product_service_port
USER_SERVICE_URL=your_user_service_url
PRODUCT_SERVICE_URL=your_product_service_url

# Application Environment
APP_ENV=production
LOG_LEVEL=info

# CORS Configuration
CORS_ORIGINS=your_cors_origins

# Timeout Configuration
REQUEST_TIMEOUT=your_request_timeout

# Security Configuration
BCRYPT_COST=your_bcrypt_cost
TOKEN_EXPIRY_HOURS=your_token_expiry_hours

# Database Pool Configuration
DB_POOL_SIZE=your_db_pool_size
DB_POOL_TIMEOUT=your_db_pool_timeout
# API Gateway Configuration
PORT=8000
JWT_SECRET=your-secret-key-change-in-production

# User Service Configuration
USER_SERVICE_PORT=8001
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your-database-password
DB_NAME=userdb
DB_SSLMODE=disable

# Product Service Configuration
PRODUCT_SERVICE_PORT=8002
PRODUCT_DB_HOST=localhost
PRODUCT_DB_PORT=5432
PRODUCT_DB_USER=postgres
PRODUCT_DB_PASSWORD=your-database-password
PRODUCT_DB_NAME=productdb
PRODUCT_DB_SSLMODE=disable

# Service URLs (for Docker/Kubernetes)
USER_SERVICE_URL=user-service:8001
PRODUCT_SERVICE_URL=product-service:8002
